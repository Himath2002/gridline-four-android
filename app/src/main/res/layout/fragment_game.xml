<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_title" android:textAppearance="@style/TextAppearance.GridlineFour.Headline" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/player_one_avatar" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/player_one" android:src="@drawable/avatar_orbit" />
            <TextView android:id="@+id/player_one_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:textAppearance="@style/TextAppearance.GridlineFour.Section" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/versus_short" android:textColor="@color/ink_muted" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/player_two_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:layout_weight="1" android:gravity="end" android:textAppearance="@style/TextAppearance.GridlineFour.Section" />
            <ImageView android:id="@+id/player_two_avatar" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/player_two" android:src="@drawable/avatar_comet" />
        </LinearLayout>

        <TextView android:id="@+id/status_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:textAppearance="@style/TextAppearance.GridlineFour.Section" />

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/board_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_board"
            android:padding="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:orientation="horizontal">
            <TextView android:id="@+id/moves_made_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/ink_muted" android:textSize="14sp" />
            <TextView android:id="@+id/moves_remaining_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/ink_muted" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/restart_button" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/restart" />
            <com.google.android.material.button.MaterialButton android:id="@+id/undo_button" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/undo" />
            <com.google.android.material.button.MaterialButton android:id="@+id/session_button" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
